                alert('โรงแรมนี้อยู่ในรายการโปรดของคุณแล้ว');
                return;
            }
            
            userFavorites.push(hotelId);
            localStorage.setItem(`favorites_${currentUser.email}`, JSON.stringify(userFavorites));
            alert('เพิ่มโรงแรมในรายการโปรดสำเร็จ!');
        }

        // ฟังก์ชันสลับแท็บในแดชบอร์ด
        function switchTab(tabId) {
            // อัพเดทแท็บที่ active
            document.querySelectorAll('.tab').forEach(tab => {
                tab.classList.remove('active');
            });
            document.querySelector(`.tab[data-tab="${tabId}"]`).classList.add('active');
            
            // อัพเดทเนื้อหาแท็บที่ active
            document.querySelectorAll('.tab-content').forEach(content => {
                content.classList.remove('active');
            });
            document.getElementById(`${tabId}-tab`).classList.add('active');
            
            // โหลดข้อมูลตามแท็บ
            if (tabId === 'bookings') {
                loadUserBookings();
            } else if (tabId === 'favorites') {
                loadUserFavorites();
            } else if (tabId === 'profile') {
                loadUserProfile();
            }
        }

        // ฟังก์ชันโหลดการจองของผู้ใช้
        function loadUserBookings() {
            const userBookingsContainer = document.getElementById('user-bookings');
            
            if (userBookings.length === 0) {
                userBookingsContainer.innerHTML = '<p>คุณยังไม่มีการจองใดๆ</p>';
                return;
            }
            
            userBookingsContainer.innerHTML = userBookings.map(booking => {
                const hotel = hotelsData.find(h => h.id == booking.hotelId);
                return `
                    <div class="booking-item">
                        <div class="booking-header">
                            <h3>${hotel.name}</h3>
                            <span class="booking-status status-${booking.status}">${booking.status === 'confirmed' ? 'ยืนยันแล้ว' : 'รอดำเนินการ'}</span>
                        </div>
                        <p><strong>วันที่เช็คอิน:</strong> ${booking.checkIn}</p>
                        <p><strong>วันที่เช็คเอาต์:</strong> ${booking.checkOut}</p>
                        <p><strong>จำนวนคืน:</strong> ${booking.nights} คืน</p>
                        <p><strong>จำนวนห้อง:</strong> ${booking.rooms} ห้อง</p>
                        <p><strong>ราคารวม:</strong> ${booking.totalPrice.toLocaleString()} ฿</p>
                        ${booking.specialRequests ? `<p><strong>คำขอพิเศษ:</strong> ${booking.specialRequests}</p>` : ''}
                    </div>
                `;
            }).join('');
        }

        // ฟังก์ชันโหลดรายการโปรดของผู้ใช้
        function loadUserFavorites() {
            const userFavoritesContainer = document.getElementById('user-favorites');
            
            if (userFavorites.length === 0) {
                userFavoritesContainer.innerHTML = '<p>คุณยังไม่มีโรงแรมในรายการโปรด</p>';
                return;
            }
            
            const favoriteHotels = hotelsData.filter(hotel => userFavorites.includes(hotel.id));
            
            userFavoritesContainer.innerHTML = favoriteHotels.map(hotel => `
                <div class="hotel-card">
                    <div class="hotel-image">
                        <img src="${hotel.image}" alt="${hotel.name}">
                    </div>
                    <div class="hotel-details">
                        <div>
                            <h3 class="hotel-name">${hotel.name}</h3>
                            <div class="hotel-location">
                                <i class="fas fa-map-marker-alt"></i>
                                ${hotel.location}, ประเทศไทย
                            </div>
                            <div class="hotel-rating">
                                <div class="rating-stars">
                                    ${'★'.repeat(Math.floor(hotel.rating))}${hotel.rating % 1 !== 0 ? '½' : ''}${'☆'.repeat(5 - Math.ceil(hotel.rating))}
                                </div>
                                <span class="rating-value">${hotel.rating}</span>
                            </div>
                        </div>
                        <div class="hotel-price">
                            <div class="price">${hotel.price.toLocaleString()} ฿</div>
                            <div class="price-note">ต่อคืน</div>
                            <button class="btn btn-primary view-hotel-btn" data-hotel-id="${hotel.id}">ดูรายละเอียด</button>
                            <button class="btn btn-outline remove-favorite" data-hotel-id="${hotel.id}">ลบออก</button>
                        </div>
                    </div>
                </div>
            `).join('');
            
            // เพิ่ม Event Listeners
            document.querySelectorAll('.view-hotel-btn').forEach(button => {
                button.addEventListener('click', function() {
                    const hotelId = this.getAttribute('data-hotel-id');
                    showHotelDetails(hotelId);
                });
            });
            
            document.querySelectorAll('.remove-favorite').forEach(button => {
                button.addEventListener('click', function() {
                    const hotelId = this.getAttribute('data-hotel-id');
                    removeFromFavorites(hotelId);
                });
            });
        }

        // ฟังก์ชันลบออกจากรายการโปรด
        function removeFromFavorites(hotelId) {
            userFavorites = userFavorites.filter(id => id != hotelId);
            localStorage.setItem(`favorites_${currentUser.email}`, JSON.stringify(userFavorites));
            loadUserFavorites();
            alert('ลบโรงแรมออกจากรายการโปรดสำเร็จ');
        }

        // ฟังก์ชันโหลดข้อมูลโปรไฟล์ผู้ใช้
        function loadUserProfile() {
            document.getElementById('profile-firstname').value = currentUser.firstname;
            document.getElementById('profile-lastname').value = currentUser.lastname;
            document.getElementById('profile-email').value = currentUser.email;
            document.getElementById('profile-phone').value = currentUser.phone;
            
            // เพิ่ม Event Listener สำหรับปุ่มอัพเดทโปรไฟล์
            document.getElementById('update-profile').addEventListener('click', updateUserProfile);
        }

        // ฟังก์ชันอัพเดทโปรไฟล์ผู้ใช้
        function updateUserProfile() {
            const firstname = document.getElementById('profile-firstname').value;
            const lastname = document.getElementById('profile-lastname').value;
            const email = document.getElementById('profile-email').value;
            const phone = document.getElementById('profile-phone').value;
            
            // อัพเดทข้อมูลผู้ใช้
            currentUser.firstname = firstname;
            currentUser.lastname = lastname;
            currentUser.email = email;
            currentUser.phone = phone;
            
            // อัพเดทใน localStorage
            localStorage.setItem('currentUser', JSON.stringify(currentUser));
            
            // อัพเดทข้อมูลผู้ใช้ใน users array
            const users = JSON.parse(localStorage.getItem('users') || '[]');
            const userIndex = users.findIndex(u => u.email === currentUser.email);
            if (userIndex !== -1) {
                users[userIndex] = currentUser;
                localStorage.setItem('users', JSON.stringify(users));
            }
            
            // อัพเดท UI
            userName.textContent = currentUser.firstname;
            
            alert('อัพเดทข้อมูลส่วนตัวสำเร็จ!');
        }
    </script>
</body>
</html>
