        // ฟังก์ชันจัดการการเรียงลำดับ
        function handleSort() {
            const sortBy = sortResults.value;
            const currentHotels = Array.from(document.querySelectorAll('.hotel-card'));
            
            let sortedHotels;
            
            switch(sortBy) {
                case 'price-asc':
                    sortedHotels = currentHotels.sort((a, b) => {
                        const priceA = parseInt(a.querySelector('.price').textContent.replace(/,/g, ''));
                        const priceB = parseInt(b.querySelector('.price').textContent.replace(/,/g, ''));
                        return priceA - priceB;
                    });
                    break;
                case 'price-desc':
                    sortedHotels = currentHotels.sort((a, b) => {
                        const priceA = parseInt(a.querySelector('.price').textContent.replace(/,/g, ''));
                        const priceB = parseInt(b.querySelector('.price').textContent.replace(/,/g, ''));
                        return priceB - priceA;
                    });
                    break;
                case 'rating':
                    sortedHotels = currentHotels.sort((a, b) => {
                        const ratingA = parseFloat(a.querySelector('.rating-value').textContent);
                        const ratingB = parseFloat(b.querySelector('.rating-value').textContent);
                        return ratingB - ratingA;
                    });
                    break;
                case 'name':
                    sortedHotels = currentHotels.sort((a, b) => {
                        const nameA = a.querySelector('.hotel-name').textContent;
                        const nameB = b.querySelector('.hotel-name').textContent;
                        return nameA.localeCompare(nameB, 'th');
                    });
                    break;
                default:
                    sortedHotels = currentHotels;
            }
            
            // อัพเดท DOM ด้วยผลลัพธ์ที่เรียงแล้ว
            hotelsList.innerHTML = '';
            sortedHotels.forEach(hotel => hotelsList.appendChild(hotel));
        }

