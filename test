        const dashboardBtn = document.getElementById('dashboard-btn');
        const loginModal = document.getElementById('login-modal');
        const registerModal = document.getElementById('register-modal');
        const closeLogin = document.getElementById('close-login');
        const closeRegister = document.getElementById('close-register');
        const closeLoginBtn = document.getElementById('close-login-btn');
        const closeRegisterBtn = document.getElementById('close-register-btn');
        const loginForm = document.getElementById('login-form');
        const registerForm = document.getElementById('register-form');
        const searchHotelsBtn = document.getElementById('search-hotels');
        const hotelsList = document.getElementById('hotels-list');
        const resultsCount = document.getElementById('results-count');
        const sortResults = document.getElementById('sort-results');
        const specialOffers = document.getElementById('special-offers');

        // ฟังก์ชันเริ่มต้น
        document.addEventListener('DOMContentLoaded', function() {
            // ตั้งค่าวันเช็คอินเป็นวันพรุ่งนี้
            const tomorrow = new Date();
            tomorrow.setDate(tomorrow.getDate() + 1);
            document.getElementById('check-in').valueAsDate = new Date();
            document.getElementById('check-out').valueAsDate = tomorrow;
            
            // โหลดข้อเสนอพิเศษ
            loadSpecialOffers();
            
            // ตรวจสอบสถานะการเข้าสู่ระบบ
            checkLoginStatus();
            
            // เพิ่ม Event Listeners
            setupEventListeners();
        });

        // ตั้งค่า Event Listeners
        function setupEventListeners() {
            // Navigation
            navLinks.forEach(link => {
                link.addEventListener('click', function(e) {
                    e.preventDefault();
                    const page = this.getAttribute('data-page');
                    showPage(page);
                });
            });

            // Authentication
            loginBtn.addEventListener('click', () => loginModal.style.display = 'flex');
            registerBtn.addEventListener('click', () => registerModal.style.display = 'flex');
            logoutBtn.addEventListener('click', logout);
            dashboardBtn.addEventListener('click', () => showPage('dashboard'));

            // Modal Close
            closeLogin.addEventListener('click', () => loginModal.style.display = 'none');
            closeRegister.addEventListener('click', () => registerModal.style.display = 'none');
            closeLoginBtn.addEventListener('click', () => loginModal.style.display = 'none');
            closeRegisterBtn.addEventListener('click', () => registerModal.style.display = 'none');

            // Forms
            loginForm.addEventListener('submit', handleLogin);
            registerForm.addEventListener('submit', handleRegister);

            // Search
            searchHotelsBtn.addEventListener('click', handleSearch);
            sortResults.addEventListener('change', handleSort);

            // Dashboard Tabs
            document.querySelectorAll('.tab').forEach(tab => {
                tab.addEventListener('click', function() {
                    const tabId = this.getAttribute('data-tab');
                    switchTab(tabId);
                });
            });

            // Close modal when clicking outside
            window.addEventListener('click', function(e) {
                if (e.target === loginModal) {
                    loginModal.style.display = 'none';
                }
                if (e.target === registerModal) {
                    registerModal.style.display = 'none';
                }
            });
        }

        // ฟังก์ชันแสดงหน้า
        function showPage(pageName) {
            pages.forEach(page => {
                page.style.display = 'none';
            });
            
            document.getElementById(`${pageName}-page`).style.display = 'block';
            
            // ถ้าเป็นหน้าแดชบอร์ดและผู้ใช้ยังไม่ได้ล็อกอิน ให้แสดงหน้าเข้าสู่ระบบ
            if (pageName === 'dashboard' && !currentUser) {
                loginModal.style.display = 'flex';
                showPage('home');
            }
        }

        // ฟังก์ชันตรวจสอบสถานะการเข้าสู่ระบบ
        function checkLoginStatus() {
            const savedUser = localStorage.getItem('currentUser');
            if (savedUser) {
                currentUser = JSON.parse(savedUser);
                updateUIForLoggedInUser();
            }
        }

        // ฟังก์ชันอัพเดท UI สำหรับผู้ใช้ที่ล็อกอินแล้ว
        function updateUIForLoggedInUser() {
            authButtons.style.display = 'none';
            userMenu.style.display = 'flex';
            userName.textContent = currentUser.firstname;
            
            // โหลดข้อมูลการจองและรายการโปรด
            const savedBookings = localStorage.getItem(`bookings_${currentUser.email}`);
            const savedFavorites = localStorage.getItem(`favorites_${currentUser.email}`);
            
            if (savedBookings) {
                userBookings = JSON.parse(savedBookings);
            }
            
            if (savedFavorites) {
                userFavorites = JSON.parse(savedFavorites);
            }
        }

        // ฟังก์ชันจัดการการเข้าสู่ระบบ
        function handleLogin(e) {
            e.preventDefault();
            const email = document.getElementById('login-email').value;
            const password = document.getElementById('login-password').value;
            
            // ตรวจสอบข้อมูลจาก localStorage
            const users = JSON.parse(localStorage.getItem('users') || '[]');
            const user = users.find(u => u.email === email && u.password === password);
            
            if (user) {
                currentUser = user;
                localStorage.setItem('currentUser', JSON.stringify(currentUser));
                updateUIForLoggedInUser();
                loginModal.style.display = 'none';
                alert('เข้าสู่ระบบสำเร็จ!');
            } else {
                alert('อีเมลหรือรหัสผ่านไม่ถูกต้อง');
            }
        }

        // ฟังก์ชันจัดการการสมัครสมาชิก
        function handleRegister(e) {
            e.preventDefault();
            const firstname = document.getElementById('register-firstname').value;
            const lastname = document.getElementById('register-lastname').value;
            const email = document.getElementById('register-email').value;
            const phone = document.getElementById('register-phone').value;
            const password = document.getElementById('register-password').value;
            const confirmPassword = document.getElementById('register-confirm-password').value;
            
            if (password !== confirmPassword) {
                alert('รหัสผ่านไม่ตรงกัน');
                return;
            }
            
            // ตรวจสอบว่ามีผู้ใช้แล้วหรือไม่
            const users = JSON.parse(localStorage.getItem('users') || '[]');
            const existingUser = users.find(u => u.email === email);
            
            if (existingUser) {
                alert('มีผู้ใช้ด้วยอีเมลนี้แล้ว');
                return;
            }
            
            // บันทึกผู้ใช้ใหม่
            const newUser = { firstname, lastname, email, phone, password };
            users.push(newUser);
            localStorage.setItem('users', JSON.stringify(users));
            
            alert('สมัครสมาชิกสำเร็จ! กรุณาเข้าสู่ระบบ');
            registerModal.style.display = 'none';
            registerForm.reset();
        }

        // ฟังก์ชันออกจากระบบ
        function logout() {
            currentUser = null;
            localStorage.removeItem('currentUser');
            authButtons.style.display = 'flex';
            userMenu.style.display = 'none';
            showPage('home');
            alert('ออกจากระบบสำเร็จ');
        }

        // ฟังก์ชันโหลดข้อเสนอพิเศษ
        function loadSpecialOffers() {
            const specialHotels = hotelsData.filter(hotel => hotel.originalPrice > hotel.price);
            
            specialOffers.innerHTML = specialHotels.map(hotel => `
