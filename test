        // ฟังก์ชันยืนยันการจอง
        function confirmBooking(hotelId, nights, rooms, totalPrice) {
            const hotel = hotelsData.find(h => h.id == hotelId);
            const checkIn = document.getElementById('booking-checkin').value;
            const checkOut = document.getElementById('booking-checkout').value;
            const specialRequests = document.getElementById('booking-special').value;
            
            const booking = {
                id: Date.now(),
                hotelId: hotelId,
                hotelName: hotel.name,
                checkIn: checkIn,
                checkOut: checkOut,
                nights: nights,
                rooms: rooms,
                totalPrice: totalPrice,
                status: 'confirmed',
                bookingDate: new Date().toISOString().split('T')[0],
                specialRequests: specialRequests
            };
            
            userBookings.push(booking);
            localStorage.setItem(`bookings_${currentUser.email}`, JSON.stringify(userBookings));
            
            alert('การจองสำเร็จ! เราได้ส่งอีเมลยืนยันการจองให้คุณแล้ว');
            showPage('dashboard');
        }

        // ฟังก์ชันเพิ่มในรายการโปรด
        function addToFavorites(hotelId) {
